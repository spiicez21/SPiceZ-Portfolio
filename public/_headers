/* Fonts */
/webfonts/*
  Cache-Control: public, max-age=31536000, immutable

/* Assets */
/Picture/*
  Cache-Control: public, max-age=31536000, immutable
/Spotify-Badge/*
  Cache-Control: public, max-age=31536000, immutable

/* 3D payloads - large and never change without a filename change */
/fonko-spz/*
  Cache-Control: public, max-age=31536000, immutable
/HDR/*
  Cache-Control: public, max-age=31536000, immutable
/Favicon/*
  Cache-Control: public, max-age=31536000, immutable
/Resume/*
  Cache-Control: public, max-age=604800

/* Hashed build output */
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/* SPA fallback for clean URLs */
/* Netlify handles this via _redirects usually, but headers can coexist */
